<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ report.date }} {{ report.title }}</title>
<style>
@page { size: A4; margin: 18mm 18mm 16mm; }
body { margin: 0; font-family: "Noto Sans KR", "NanumBarunGothic", sans-serif; color: #1f2933; background: #f4f6f8; line-height: 1.68; }
.report-page { max-width: 1040px; margin: 0 auto; padding: 40px 44px 56px; background: #fff; }
.header { display:flex; justify-content:space-between; font-size:12px; color:#66607a; border-bottom:1px solid #d9d4e6; padding-bottom:10px; margin-bottom:28px; }
.section { margin: 34px 0 42px; }
.section-label { color:#4f46e5; font-weight:800; font-size:13px; letter-spacing:.04em; break-after: avoid; }
.section-title { font-size: 26px; font-weight:800; margin: 4px 0 16px; break-after: avoid; }
p { orphans: 2; widows: 2; }
.keep-together, .table-block, .term-box, .takeaway { break-inside: avoid; page-break-inside: avoid; }
table { width:100%; border-collapse:collapse; table-layout:fixed; margin-top:8px; }
th, td { border:1px solid #c7c1d9; padding:8px 10px; vertical-align:top; }
th { background:#e9e4f4; font-weight:800; }
th:first-child, td:first-child { width:14%; white-space:nowrap; font-weight:700; }
.caption { font-size:13px; color:#6b647c; margin-top:8px; text-align:center; }
@media print { body { background:#fff; } .report-page { padding:0; max-width:none; } }
</style>
</head>
<body>
<main class="report-page">
  <div class="header"><div>GLOBAL KNOWLEDGE JOURNAL / {{ report.date }}</div><div>{{ report.category.main }} / {{ report.category.middle }}</div></div>
  <h1>{{ report.title }}</h1>
  <p class="subtitle">{{ report.subtitle }}</p>

  {% for section in report.sections %}
  {% set section_text = (section.label ~ ' ' ~ section.title) %}
  {% if 'PROJECT DB' not in section_text and '주제 DB' not in section_text and '운영 메모' not in section_text and '다음 회차 후보' not in section_text and '후보 우선순위' not in section_text and '반복 회피' not in section_text and '다양성 확보' not in section_text %}
  <section class="section">
    <div class="section-label">{{ section.label }}</div>
    <div class="section-title">{{ section.title }}</div>
    {% for paragraph in section.body %}<p>{{ paragraph }}</p>{% endfor %}
  </section>
  {% endif %}
  {% endfor %}

  {% for table in report.tables %}
  {% set table_text = table.title %}
  {% if 'PROJECT DB' not in table_text and '주제 DB' not in table_text and '운영 메모' not in table_text and '다음 회차 후보' not in table_text and '후보 우선순위' not in table_text and '반복 회피' not in table_text and '다양성 확보' not in table_text %}
  <div class="section table-block keep-together">
    <div class="section-label">TABLE</div>
    <div class="section-title">{{ table.title }}</div>
    <table>
      <thead><tr>{% for header in table.headers %}<th>{{ header }}</th>{% endfor %}</tr></thead>
      <tbody>{% for row in table.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table>
    <div class="caption">{{ table.caption }}</div>
  </div>
  {% endif %}
  {% endfor %}
</main>
</body>
</html>
