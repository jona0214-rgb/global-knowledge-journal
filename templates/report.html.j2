<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<title>{{ report.title }}</title>

<style>
@page {
  size: A4;
}

:root {
  --paper: #fffdf8;
  --ink: #1f1b16;
  --body: #2b241d;
  --muted: #665c52;
  --line: #cbbba7;
  --line-soft: #ded1c2;
  --accent: #8a5a2b;
  --accent-dark: #4d3018;
  --table-header: #e7d9c5;
  --box-bg: #f8f3ec;
  --box-bg-strong: #f1e6d8;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

body {
  font-family:
    "Noto Sans KR",
    "Noto Sans CJK KR",
    "Pretendard",
    "NanumGothic",
    "Nanum Gothic",
    "Malgun Gothic",
    "Apple SD Gothic Neo",
    sans-serif;
  color: var(--body);
  background: #f4f0e8;
  line-height: 1.62;
  word-break: keep-all;
  overflow-wrap: break-word;
}

{% set raw_date = report.date|string %}
{% if raw_date|length >= 10 %}
  {% set date_dot = raw_date[0:4] ~ "." ~ raw_date[5:7] ~ "." ~ raw_date[8:10] %}
  {% set date_kr = raw_date[0:4] ~ "년 " ~ raw_date[5:7] ~ "월 " ~ raw_date[8:10] ~ "일" %}
{% else %}
  {% set date_dot = raw_date %}
  {% set date_kr = raw_date %}
{% endif %}

.report-page {
  background: var(--paper);
}

.screen-header {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 7px;
  margin-bottom: 18px;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
  font-size: 10.8px;
  font-weight: 700;
  letter-spacing: 0.01em;
}

.print-header,
.print-footer {
  display: none;
}

.cover {
  margin-bottom: 15px;
  padding-bottom: 13px;
  border-bottom: 1.5px solid var(--accent-dark);
}

.journal-label {
  margin: 0 0 8px;
  color: var(--accent);
  font-size: 11.2px;
  font-weight: 900;
  letter-spacing: 0.05em;
}

h1 {
  margin: 0;
  color: var(--ink);
  font-size: 33px;
  line-height: 1.16;
  letter-spacing: -0.055em;
  font-weight: 900;
}

.subtitle {
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 14.7px;
  line-height: 1.48;
}

.meta-table {
  width: 100%;
  margin-top: 15px;
  border-collapse: collapse;
  table-layout: fixed;
  font-size: 11.7px;
  background: #ffffff;
}

.meta-table th,
.meta-table td {
  border: 1px solid var(--line);
  padding: 5.5px 7px;
  vertical-align: middle;
}

.meta-table th {
  width: 10%;
  background: var(--table-header);
  color: var(--accent-dark);
  font-weight: 900;
  white-space: nowrap;
}

.keyword-line {
  margin-top: 9px;
  padding-top: 8px;
  border-top: 1px solid var(--line);
  color: var(--body);
  font-size: 12px;
  line-height: 1.45;
}

.keyword-line strong {
  color: var(--accent);
}

.abstract {
  margin: 15px 0 13px;
  padding: 12px 14px;
  background: var(--box-bg);
  border: 1px solid var(--line);
  border-left: 5px solid var(--accent);
}

.abstract-title {
  margin: 0 0 5px;
  color: var(--accent-dark);
  font-size: 14.2px;
  font-weight: 900;
}

.note-box {
  margin: 11px 0 17px;
  padding: 11px 14px;
  background: var(--box-bg);
  border: 1px solid var(--line);
}

.note-box p {
  margin-bottom: 5px;
}

.note-caption {
  margin-top: 4px;
  color: var(--muted);
  font-size: 11.4px;
  line-height: 1.45;
}

.section {
  display: contents;
  margin: 0 0 20px;
  padding: 0;
  border: 0;
}

.section > p:last-child {
  margin-bottom: 20px;
}

.section .section-lead {
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid var(--line-soft);
}

.section.first-section .section-lead {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}

.section-label {
  margin-bottom: 4px;
  color: var(--accent);
  font-size: 11.3px;
  font-weight: 900;
  letter-spacing: 0.07em;
  break-after: avoid;
}

.section-title {
  margin: 0 0 8px;
  color: var(--ink);
  font-size: 20.5px;
  line-height: 1.28;
  letter-spacing: -0.04em;
  font-weight: 900;
  break-after: avoid;
}

.subsection {
  margin: 0 0 17px;
  padding: 0;
  border: 0;
}

.subsection .section-lead {
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid #ebe4dc;
}

.subsection-title {
  margin: 0 0 7px;
  color: var(--ink);
  font-size: 16.2px;
  line-height: 1.35;
  letter-spacing: -0.035em;
  font-weight: 900;
  break-after: avoid;
}

.subsection-title .subsection-label-inline {
  color: var(--accent);
  margin-right: 4px;
}

.section-lead {
  display: block;
}

p {
  margin: 0 0 8px;
  font-size: 13.25px;
  line-height: 1.64;
  orphans: 3;
  widows: 3;
  break-inside: avoid;
  page-break-inside: avoid;
}

strong {
  color: var(--accent-dark);
}

.keep-together,
.table-block,
.term-box,
.flow-block,
.takeaway-block,
.reading-block,
.abstract,
.note-box {
  break-inside: avoid;
  page-break-inside: avoid;
}

.term-box {
  margin: 14px 0 16px;
  padding: 12px 14px;
  background: var(--box-bg);
  border: 1px solid var(--line);
}

.box-title {
  margin: 0 0 9px;
  color: var(--accent-dark);
  font-size: 15.5px;
  font-weight: 900;
  letter-spacing: -0.02em;
}

.term-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border: 1px solid var(--line);
  background: #ffffff;
}

.term-item {
  min-height: 68px;
  padding: 9px 10px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.term-item:nth-child(2n) {
  border-right: 0;
}

.term-item:nth-last-child(-n+2) {
  border-bottom: 0;
}

.term-name {
  margin: 0 0 4px;
  color: var(--accent);
  font-size: 12.8px;
  font-weight: 900;
}

.term-description {
  margin: 0;
  color: var(--body);
  font-size: 11.9px;
  line-height: 1.5;
}

.flow-block {
  margin: 14px 0 20px;
  padding: 12px 14px;
  background: #fffdf8;
  border: 1px solid var(--line);
}

.flow-title {
  margin: 0 0 8px;
  color: var(--accent-dark);
  font-size: 14.2px;
  font-weight: 900;
}

.flow-steps {
  display: flex;
  align-items: stretch;
  gap: 6px;
  margin: 8px 0;
}

.flow-step {
  flex: 1 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 34px;
  padding: 6px 7px;
  background: var(--box-bg-strong);
  border: 1px solid var(--line);
  color: var(--ink);
  font-size: 11.7px;
  font-weight: 800;
  text-align: center;
  line-height: 1.35;
}

.flow-arrow {
  display: flex;
  align-items: center;
  color: var(--accent);
  font-size: 14px;
  font-weight: 900;
}

.caption,
.flow-caption {
  margin-top: 6px;
  color: var(--muted);
  font-size: 10.8px;
  line-height: 1.42;
  text-align: center;
}

.table-block {
  margin: 16px 0 20px;
  break-inside: avoid;
  page-break-inside: avoid;
}

.table-title {
  margin: 0 0 6px;
  color: var(--accent-dark);
  font-size: 12px;
  font-weight: 400;
}

table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  margin-top: 5px;
  background: #ffffff;
  font-size: 11.5px;
}

th,
td {
  border: 1px solid var(--line);
  padding: 5.6px 6.4px;
  vertical-align: top;
  line-height: 1.45;
}

th {
  background: var(--table-header);
  color: var(--accent-dark);
  font-weight: 900;
}

th:first-child,
td:first-child {
  width: 15%;
  font-weight: 900;
}

.takeaway-block {
  margin: 20px 0 20px;
}

.takeaway-title {
  margin: 0;
  color: var(--accent);
  font-size: 11.3px;
  font-weight: 900;
  letter-spacing: 0.07em;
}

.takeaway-subtitle {
  margin: 3px 0 10px;
  color: var(--ink);
  font-size: 19px;
  line-height: 1.28;
  letter-spacing: -0.04em;
  font-weight: 900;
}

.takeaway-list {
  display: grid;
  gap: 8px;
}

.takeaway-card {
  padding: 10px 12px;
  background: var(--box-bg);
  border: 1px solid var(--line);
  border-left: 5px solid var(--accent);
}

.takeaway-card-title {
  margin: 0 0 4px;
  color: var(--accent);
  font-size: 12.7px;
  font-weight: 900;
}

.takeaway-card p {
  margin-bottom: 0;
}

.reading-block {
  margin: 18px 0 12px;
}

.reading-list {
  margin: 7px 0 0;
  padding-left: 17px;
}

.reading-list li {
  margin: 5px 0;
  font-size: 12.3px;
  line-height: 1.5;
}

.sources {
  margin-top: 15px;
  padding-top: 9px;
  border-top: 1px solid var(--line);
}

.final-reference-page {
  break-before: page;
  page-break-before: always;
}

.sources-title {
  margin: 0 0 5px;
  color: var(--ink);
  font-size: 13.5px;
  font-weight: 900;
}

.source-list {
  margin: 0;
  padding-left: 0;
  list-style: none;
}

.source-list li {
  display: inline;
  color: var(--muted);
  font-size: 9.8px;
  line-height: 1.42;
}

.source-list li::after {
  content: "; ";
}

.source-list li:last-child::after {
  content: "";
}

.source-list a {
  color: var(--muted);
  text-decoration: none;
}

.footer-note {
  margin-top: 18px;
  padding-top: 8px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 10.2px;
  text-align: center;
}

@media screen {
  .report-page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 34px 42px 52px;
    box-shadow: 0 18px 42px rgba(57, 38, 20, 0.08);
  }
}

@media screen and (max-width: 768px) {
  .report-page {
    padding: 24px 18px 40px;
  }

  h1 {
    font-size: 28px;
  }

  .meta-table,
  .meta-table tbody,
  .meta-table tr,
  .meta-table th,
  .meta-table td {
    display: block;
    width: 100%;
  }

  .meta-table th {
    border-bottom: 0;
  }

  .term-grid {
    grid-template-columns: 1fr;
  }

  .term-item,
  .term-item:nth-child(2n),
  .term-item:nth-last-child(-n+2) {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .term-item:last-child {
    border-bottom: 0;
  }

  .flow-steps {
    flex-direction: column;
  }

  .flow-arrow {
    justify-content: center;
    transform: rotate(90deg);
  }
}

@media print {
  body {
    background: #ffffff;
  }

  .screen-header {
    display: none;
  }

  /* The repeating header is supplied by Playwright's header template. */
  .print-header {
    display: none !important;
  }

  .print-footer {
    display: none;
  }

  .report-page {
    max-width: none;
    margin: 0;
    padding: 0;
    /* Keep Playwright's running header/footer above every page fragment. */
    background: transparent;
    box-shadow: none;
  }

  h1 {
    font-size: 28.5px;
  }

  .subtitle {
    font-size: 13px;
  }

  .journal-label {
    font-size: 10.3px;
  }

  .meta-table {
    font-size: 10.4px;
  }

  .meta-table th,
  .meta-table td {
    padding: 4.5px 5.6px;
  }

  .keyword-line {
    font-size: 11px;
  }

  .abstract {
    margin: 12px 0 10px;
    padding: 10px 12px;
  }

  .section {
    margin: 0 0 16px;
    padding: 0;
  }

  .section > p:last-child {
    margin-bottom: 16px;
  }

  .section .section-lead {
    margin-top: 15px;
    padding-top: 11px;
  }

  .section.first-section .section-lead {
    margin-top: 0;
    padding-top: 0;
  }

  .subsection {
    margin: 0 0 16px;
    padding: 0;
  }

  .subsection .section-lead {
    margin-top: 15px;
    padding-top: 10px;
  }

  .section-title {
    font-size: 18.2px;
  }

  .subsection-title {
    font-size: 14.8px;
  }

  p {
    font-size: 12.15px;
    line-height: 1.62;
    margin-bottom: 7px;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .section-label,
  .section-title,
  .subsection-title {
    break-after: avoid;
    page-break-after: avoid;
  }

  .final-reference-page {
    break-before: page;
    page-break-before: always;
  }

  .final-reference-page .reading-block,
  .final-reference-page .table-block,
  .final-reference-page .sources {
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .final-reference-page .source-list li {
    font-size: 9.2px;
    line-height: 1.35;
  }

  .term-description {
    font-size: 10.7px;
  }

  .flow-step {
    font-size: 10.6px;
    min-height: 30px;
    padding: 5px 5px;
  }

  table {
    font-size: 10.25px;
  }

  th,
  td {
    padding: 4.5px 5.3px;
  }

  .caption,
  .flow-caption {
    font-size: 9.7px;
  }

  .takeaway-card {
    padding: 8px 10px;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .reading-list li {
    font-size: 10.9px;
  }

  .footer-note {
    display: none;
  }
}
</style>
</head>

<body>

{% set raw_date = report.date|string %}
{% if raw_date|length >= 10 %}
  {% set date_dot = raw_date[0:4] ~ "." ~ raw_date[5:7] ~ "." ~ raw_date[8:10] %}
  {% set date_kr = raw_date[0:4] ~ "년 " ~ raw_date[5:7] ~ "월 " ~ raw_date[8:10] ~ "일" %}
{% else %}
  {% set date_dot = raw_date %}
  {% set date_kr = raw_date %}
{% endif %}

{% macro render_note(note) %}
{% if note is defined and note %}
<section class="note-box keep-together">
  {% if note.body is defined and note.body %}
  <p><strong>{{ note.body }}</strong></p>
  {% endif %}
  {% if note.caption is defined and note.caption %}
  <div class="note-caption">{{ note.caption }}</div>
  {% endif %}
</section>
{% endif %}
{% endmacro %}

{% macro render_notes_for(hints) %}
{% if report.section_notes is defined %}
  {% for note in report.section_notes %}
    {% set placement_hint = note.get("placement_hint", "") %}
    {% if placement_hint in hints %}
      {{ render_note(note) }}
    {% endif %}
  {% endfor %}
{% endif %}
{% endmacro %}

{% macro render_section(section, first=False) %}
{% set section_id = section.get("id", "") %}
{% set section_label = section.get("label", "") %}
{% set section_title = section.get("title", "") %}
{% set section_body = section.get("body", []) %}
{% set is_subsection = section_id[0:3] == "03-" or section_id[0:2] == "3-" or section_label[0:3] == "03-" or section_label[0:2] == "3-" %}
<section class="section section-id-{{ section_id|replace('-', '_') }} {% if first %}first-section{% endif %} {% if is_subsection %}subsection{% endif %}">
  <div class="section-lead">
  {% if is_subsection %}
    <h2 class="subsection-title"><span class="subsection-label-inline">{{ section_label }}</span>{{ section_title }}</h2>
  {% else %}
    <div class="section-label">{{ section_label }}</div>
    <h2 class="section-title">{{ section_title }}</h2>
  {% endif %}
  {% if section_body %}
  <p>{{ section_body[0] }}</p>
  {% endif %}
  </div>
  {% for paragraph in section_body[1:] %}
  <p>{{ paragraph }}</p>
  {% endfor %}
</section>
{% endmacro %}

{% macro render_table(table) %}
<section class="table-block keep-together">
  <div class="table-title">{{ table.title|string|replace('**', '')|replace('__', '') }}</div>
  <table>
    <thead>
      <tr>
        {% for header in table.headers %}
        <th>{{ header }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in table.rows %}
      <tr>
        {% for cell in row %}
        <td>{{ cell|string|replace('**', '')|replace('__', '') }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if table.caption is defined and table.caption %}
  <div class="caption">{{ table.caption|string|replace('**', '')|replace('__', '') }}</div>
  {% endif %}
</section>
{% endmacro %}

{% macro render_tables_for(hints) %}
{% for table in report.tables %}
  {% set placement_hint = table.get("placement_hint", "") %}
  {% if placement_hint in hints %}
    {{ render_table(table) }}
  {% endif %}
{% endfor %}
{% endmacro %}

{% set table_state = namespace(has_table_08=false) %}
{% for table in report.tables %}
  {% if table.get("placement_hint", "") == "08" %}
    {% set table_state.has_table_08 = true %}
  {% endif %}
{% endfor %}

<div class="print-header">
  <div>GLOBAL KNOWLEDGE JOURNAL / {{ date_dot }}</div>
  <div>{{ report.category.main }} / {{ report.category.middle }}{% if report.category.sub is defined and report.category.sub %} / {{ report.category.sub }}{% endif %}</div>
</div>
<div class="print-footer"></div>

<main class="report-page">
  <header class="screen-header">
    <div>GLOBAL KNOWLEDGE JOURNAL / {{ date_dot }}</div>
    <div>{{ report.category.main }} / {{ report.category.middle }}{% if report.category.sub is defined and report.category.sub %} / {{ report.category.sub }}{% endif %}</div>
  </header>

  <section class="cover keep-together">
    <p class="journal-label">GLOBAL KNOWLEDGE JOURNAL / {{ report.category.main }} · {{ report.category.middle }}{% if report.category.sub is defined and report.category.sub %} · {{ report.category.sub }}{% endif %}</p>
    <h1>{{ report.title }}</h1>
    <p class="subtitle">{{ report.subtitle }}</p>

    <table class="meta-table">
      <tbody>
        <tr>
          <th>발행일</th>
          <td>{{ date_kr }}</td>
          <th>분야</th>
          <td>{{ report.category.main }} / {{ report.category.middle }}{% if report.category.sub is defined and report.category.sub %} / {{ report.category.sub }}{% endif %}</td>
          <th>난이도</th>
          <td>{{ report.difficulty }}</td>
        </tr>
        <tr>
          <th>예상 시간</th>
          <td>{{ report.estimated_reading_time }}</td>
          <th>카테고리</th>
          <td colspan="3">{{ report.category.main }} &gt; {{ report.category.middle }}{% if report.category.sub is defined and report.category.sub %} &gt; {{ report.category.sub }}{% endif %}</td>
        </tr>
      </tbody>
    </table>

    {% if report.keywords is defined and report.keywords %}
    <div class="keyword-line">
      <strong>핵심어:</strong>
      {% for keyword in report.keywords %}
        {{ keyword }}{% if not loop.last %} · {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </section>

  {% if report.abstract is defined and report.abstract %}
  <section class="abstract keep-together">
    <h2 class="abstract-title">Abstract</h2>
    {% if report.abstract is string %}
    <p>{{ report.abstract }}</p>
    {% else %}
      {% for paragraph in report.abstract %}
      <p>{{ paragraph }}</p>
      {% endfor %}
    {% endif %}
  </section>
  {% endif %}

  {% if report.summary_note is defined %}
    {{ render_note(report.summary_note) }}
  {% endif %}

  {% for section in report.sections %}
    {% set section_id = section.get("id", "") %}
    {% set section_label = section.get("label", "") %}
    {% if section_id in ["01", "1"] or "01 / CONTEXT" in section_label or "1 / CONTEXT" in section_label %}
      {{ render_section(section, true) }}
    {% endif %}
  {% endfor %}

  {% for section in report.sections %}
    {% set section_id = section.get("id", "") %}
    {% set section_label = section.get("label", "") %}
    {% if section_id in ["02", "2"] or "02 / BEGINNER" in section_label or "2 / BEGINNER" in section_label %}
      {{ render_section(section) }}
    {% endif %}
  {% endfor %}

  {% if report.term_box is defined and report.term_box %}
  <section class="term-box keep-together">
    <h2 class="box-title">{{ report.term_box.title }}</h2>
    <div class="term-grid">
      {% for item in report.term_box["items"] %}
      <div class="term-item">
        <p class="term-name">{{ item.term }}</p>
        <p class="term-description">{{ item.description }}</p>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if report.flow_diagram is defined and report.flow_diagram %}
  <section class="flow-block keep-together">
    <h2 class="flow-title">{{ report.flow_diagram.title }}</h2>
    <div class="flow-steps">
      {% for step in report.flow_diagram.steps %}
      <div class="flow-step">{{ step }}</div>
      {% if not loop.last %}
      <div class="flow-arrow">→</div>
      {% endif %}
      {% endfor %}
    </div>
    {% if report.flow_diagram.caption is defined and report.flow_diagram.caption %}
    <div class="flow-caption">{{ report.flow_diagram.caption }}</div>
    {% endif %}
  </section>
  {% endif %}

  {{ render_tables_for(["02"]) }}

  {% for section in report.sections %}
    {% set section_id = section.get("id", "") %}
    {% set section_label = section.get("label", "") %}
    {% if section_id in ["03", "3"] or section_id[0:3] == "03-" or section_id[0:2] == "3-" or "03 / DEEP DIVE" in section_label or "3 / DEEP DIVE" in section_label or section_label[0:3] == "03-" or section_label[0:2] == "3-" %}
      {{ render_section(section) }}
    {% endif %}
  {% endfor %}

  {{ render_tables_for(["03", "03-5"]) }}

  {% for section in report.sections %}
    {% set section_id = section.get("id", "") %}
    {% set section_label = section.get("label", "") %}
    {% if section_id in ["04", "4"] or "04 / CASE STUDY" in section_label or "4 / CASE STUDY" in section_label %}
      {{ render_section(section) }}
    {% endif %}
  {% endfor %}

  {{ render_notes_for(["04"]) }}
  {{ render_tables_for(["04"]) }}

  {% for section in report.sections %}
    {% set section_id = section.get("id", "") %}
    {% set section_label = section.get("label", "") %}
    {% if section_id in ["05", "5"] or "05 / CURRENT STATE" in section_label or "5 / CURRENT STATE" in section_label %}
      {{ render_section(section) }}
    {% endif %}
  {% endfor %}

  {{ render_tables_for(["05"]) }}

  {% for section in report.sections %}
    {% set section_id = section.get("id", "") %}
    {% set section_label = section.get("label", "") %}
    {% if section_id in ["06", "6"] or "06 / IMPLICATIONS" in section_label or "6 / IMPLICATIONS" in section_label %}
      {{ render_section(section) }}
    {% endif %}
  {% endfor %}

  {{ render_notes_for(["06"]) }}
  {{ render_tables_for(["06"]) }}

  {% for table in report.tables %}
    {% set placement_hint = table.get("placement_hint", "") %}
    {% if placement_hint not in ["02", "03", "03-5", "04", "05", "06", "08"] %}
      {{ render_table(table) }}
    {% endif %}
  {% endfor %}

  {% if report.takeaways is defined %}
  <section class="takeaway-block">
    <div class="takeaway-title">07 / TAKEAWAYS</div>
    <h2 class="takeaway-subtitle">핵심 정리와 한마디</h2>
    <div class="takeaway-list">
      {% for item in report.takeaways %}
      <div class="takeaway-card">
        {% if item is mapping %}
          {% if item.title is defined %}
          <h3 class="takeaway-card-title">{{ item.title }}</h3>
          {% endif %}
          {% if item.body is defined %}
          <p>{{ item.body }}</p>
          {% endif %}
        {% else %}
          <p>{{ item }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <div class="final-reference-page">
  <section class="reading-block">
    <div class="section-label">08 / FURTHER READING</div>
    <h2 class="section-title">더 읽을거리</h2>

    {% if not table_state.has_table_08 and report.further_reading is defined %}
    <ul class="reading-list">
      {% for item in report.further_reading %}
      <li>
        {% if item is mapping %}
          {% if item.title is defined %}
          <strong>{{ item.title }}</strong>{% if item.author is defined and item.author %} — {{ item.author }}{% endif %}
          {% if item.reason is defined and item.reason %}
          <br />{{ item.reason }}
          {% endif %}
          {% elif item.body is defined %}
          {{ item.body }}
          {% else %}
          {{ item }}
          {% endif %}
        {% else %}
          {{ item }}
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>

  {{ render_tables_for(["08"]) }}

  {% if report.sources is defined and report.sources %}
  <section class="sources">
    <h2 class="sources-title">Sources</h2>
    <ul class="source-list">
      {% for source in report.sources %}
      <li>
        {% if source is mapping %}
          {% if source.publisher is defined %}<strong>{{ source.publisher }}</strong>{% endif %}
          {% if source.title is defined %}, {{ source.title }}{% endif %}
          {% if source.url is defined and source.url %}, <a href="{{ source.url }}">link</a>{% endif %}
          {% if source.used_for is defined and source.used_for %}, {{ source.used_for }}{% endif %}
        {% else %}
          {{ source }}
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
  </div>

  <footer class="footer-note">
    GLOBAL KNOWLEDGE JOURNAL · {{ date_dot }}
  </footer>
</main>
</body>
</html>
