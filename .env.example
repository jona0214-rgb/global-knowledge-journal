# OpenAI API 설정
# 실제 API 키는 .env 파일에만 넣고, 이 파일에는 넣지 않습니다.

OPENAI_API_KEY=your_openai_api_key_here

# 사용할 모델명
# 처음 MVP에서는 비용과 품질을 보면서 이 값을 조정할 수 있습니다.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TOPIC_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=600
OPENAI_MAX_OUTPUT_TOKENS=24000
OPENAI_MAX_RETRIES=0
OPENAI_CONNECTION_RETRIES=2
OPENAI_RETRY_BASE_SECONDS=10

# 리포트 기본 설정
REPORT_TIMEZONE=Asia/Seoul
REPORT_LANGUAGE=ko
REPORT_MIN_PAGES=7
REPORT_TARGET_PAGES=7-9
REPORT_VALIDATION_RETRIES=2
REPORT_RECOVER_MISSING_DAYS=3

# 실행 모드
# mock: API 없이 샘플 데이터로 실행
# api: OpenAI API로 실제 리포트 생성
REPORT_MODE=mock
