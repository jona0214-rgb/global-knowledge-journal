{
  "name": "daily_report",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date",
      "title",
      "title_slug",
      "subtitle",
      "difficulty",
      "estimated_reading_time",
      "category",
      "keywords",
      "abstract",
      "sections",
      "tables",
      "takeaways",
      "further_reading",
      "sources"
    ],
    "properties": {
      "date": {
        "type": "string",
        "description": "발행일. 예: 2026-07-20"
      },
      "title": {
        "type": "string",
        "description": "리포트 메인 제목"
      },
      "title_slug": {
        "type": "string",
        "description": "파일명에 사용할 짧은 한글 또는 영문 슬러그. 공백 없이 작성"
      },
      "subtitle": {
        "type": "string",
        "description": "리포트 부제"
      },
      "difficulty": {
        "type": "string",
        "description": "난이도. 하, 중, 상 중 하나"
      },
      "estimated_reading_time": {
        "type": "string",
        "description": "예상 읽기 시간. 예: 15-18분"
      },
      "category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "main",
          "middle",
          "sub"
        ],
        "properties": {
          "main": {
            "type": "string",
            "description": "대분류. 예: 언어·문자"
          },
          "middle": {
            "type": "string",
            "description": "중분류. 예: 영상번역"
          },
          "sub": {
            "type": "string",
            "description": "소분류. 예: 자막과 더빙"
          }
        }
      },
      "keywords": {
        "type": "array",
        "description": "핵심 키워드 5~8개",
        "items": {
          "type": "string"
        }
      },
      "abstract": {
        "type": "string",
        "description": "리포트 초록. 3~5문장"
      },
      "sections": {
        "type": "array",
        "description": "01~06 본문 섹션. 07과 08은 별도 필드로 처리",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "title",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "섹션 ID. 예: 01"
            },
            "label": {
              "type": "string",
              "description": "섹션 라벨. 예: 01 / CONTEXT"
            },
            "title": {
              "type": "string",
              "description": "섹션 제목"
            },
            "body": {
              "type": "array",
              "description": "섹션 본문 문단 배열. 각 문단은 2~4문장 권장",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "tables": {
        "type": "array",
        "description": "리포트에 포함할 표. 표 제목, 본체, 설명문은 같은 페이지에 배치해야 함",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "headers",
            "rows",
            "caption",
            "placement_hint"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "표 ID. 예: table_1"
            },
            "title": {
              "type": "string",
              "description": "표 제목. 예: <표1> 자막과 더빙의 차이"
            },
            "headers": {
              "type": "array",
              "description": "표 헤더",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "description": "표 행 데이터",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "caption": {
              "type": "string",
              "description": "표 아래에 들어갈 설명문. 표와 같은 페이지에 있어야 함"
            },
            "placement_hint": {
              "type": "string",
              "description": "이 표가 연결되는 섹션 ID. 예: 02, 03, 04"
            }
          }
        }
      },
      "takeaways": {
        "type": "array",
        "description": "07 / TAKEAWAYS에 들어갈 핵심 정리 박스",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "body"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "박스 제목. 예: 핵심 정리, 요약, 한마디"
            },
            "body": {
              "type": "string",
              "description": "박스 본문"
            }
          }
        }
      },
      "further_reading": {
        "type": "array",
        "description": "08 / FURTHER READING 관련 도서 목록",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "author",
            "reason"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "책 제목"
            },
            "author": {
              "type": "string",
              "description": "저자"
            },
            "reason": {
              "type": "string",
              "description": "추천 이유"
            }
          }
        }
      },
      "sources": {
        "type": "array",
        "description": "리포트 작성에 사용한 출처 목록",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisher",
            "title",
            "url",
            "used_for"
          ],
          "properties": {
            "publisher": {
              "type": "string",
              "description": "출처 기관 또는 매체"
            },
            "title": {
              "type": "string",
              "description": "출처 제목"
            },
            "url": {
              "type": "string",
              "description": "출처 URL"
            },
            "used_for": {
              "type": "string",
              "description": "이 출처를 어떤 내용에 사용했는지"
            }
          }
        }
      }
    }
  }
}