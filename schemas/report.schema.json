{
  "name": "daily_report",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date",
      "title",
      "title_slug",
      "subtitle",
      "difficulty",
      "estimated_reading_time",
      "category",
      "keywords",
      "abstract",
      "summary_note",
      "sections",
      "term_box",
      "flow_diagram",
      "tables",
      "section_notes",
      "takeaways",
      "further_reading",
      "sources"
    ],
    "properties": {
      "date": {
        "type": "string",
        "description": "발행일. 예: 2026-08-01"
      },
      "title": {
        "type": "string",
        "description": "리포트 메인 제목. 선정 주제와 정확히 같아야 한다."
      },
      "title_slug": {
        "type": "string",
        "description": "파일명에 사용할 영문 소문자 slug. 공백 없이 작성한다."
      },
      "subtitle": {
        "type": "string",
        "description": "리포트 부제"
      },
      "difficulty": {
        "type": "string",
        "description": "난이도. 예: 하, 중, 상"
      },
      "estimated_reading_time": {
        "type": "string",
        "description": "예상 읽기 시간. 예: 13-16분"
      },
      "category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "main",
          "middle",
          "sub",
          "detail"
        ],
        "properties": {
          "main": {
            "type": "string",
            "description": "대분류"
          },
          "middle": {
            "type": "string",
            "description": "중분류"
          },
          "sub": {
            "type": "string",
            "minLength": 1,
            "description": "소분류. 대분류·중분류를 반복하지 않고 주제의 구체적 분야를 적는다."
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "description": "최소 분류. 소분류보다 한 단계 더 구체적인 주제 초점을 짧게 적는다."
          }
        }
      },
      "keywords": {
        "type": "array",
        "description": "핵심어 6~8개",
        "items": {
          "type": "string"
        }
      },
      "abstract": {
        "type": "string",
        "description": "리포트 초록. 3~5문장"
      },
      "summary_note": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body",
          "caption"
        ],
        "properties": {
          "body": {
            "type": "string",
            "description": "Abstract 아래에 들어갈 짧은 관점 제시 문장. 1~2문장"
          },
          "caption": {
            "type": "string",
            "description": "보조 설명. 예: - 주요 개념과 사례를 바탕으로 정리"
          }
        }
      },

      "sections": {
        "type": "array",
        "description": "01~06 본문 섹션. 07과 08은 별도 필드로 처리한다.",
        "minItems": 11,
        "maxItems": 11,
        "items": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["01"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["02"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["03"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["03-1"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["03-2"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["03-3"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["03-4"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["03-5"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["04"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["05"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 150 } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "title", "body"],
              "properties": {
                "id": { "type": "string", "enum": ["06"] },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "body": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 150 } }
              }
            }
          ]
        }
      },
      "term_box": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "items"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "보통 '핵심 용어'로 작성한다."
          },
          "items": {
            "type": "array",
            "description": "핵심 용어 4개. 2x2 박스로 표시된다.",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "term",
                "description"
              ],
              "properties": {
                "term": {
                  "type": "string",
                  "description": "용어명"
                },
                "description": {
                  "type": "string",
                  "description": "용어 설명. 1~2문장"
                }
              }
            }
          }
        }
      },
      "flow_diagram": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "steps",
          "caption"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "흐름도 제목. 예: <그림1> 도시 하수도가 바꾼 위생의 흐름"
          },
          "steps": {
            "type": "array",
            "description": "흐름도 단계 4~6개",
            "minItems": 4,
            "items": {
              "type": "string"
            }
          },
          "caption": {
            "type": "string",
            "description": "흐름도 아래 설명"
          }
        }
      },
      "tables": {
        "type": "array",
        "description": "리포트에 포함할 표 목록. placement_hint로 배치 위치를 지정한다.",
        "minItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "headers",
            "rows",
            "caption",
            "placement_hint"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "표 ID. 예: table_1"
            },
            "title": {
              "type": "string",
              "description": "표 제목. 예: <표1> 하수도 시스템 유형별 특징 비교"
            },
            "headers": {
              "type": "array",
              "description": "표 헤더",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "description": "표 행 데이터",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "caption": {
              "type": "string",
              "description": "표 아래 설명 문장"
            },
            "placement_hint": {
              "type": "string",
              "description": "표가 연결되는 섹션 ID. 예: 03, 04, 05, 08"
            }
          }
        }
      },
      "section_notes": {
        "type": "array",
        "description": "특정 섹션 뒤에 들어가는 보조 코멘트 박스",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement_hint",
            "body",
            "caption"
          ],
          "properties": {
            "placement_hint": {
              "type": "string",
              "description": "노트가 들어갈 섹션 ID. 예: 04"
            },
            "body": {
              "type": "string",
              "description": "강조 문장. 1~2문장"
            },
            "caption": {
              "type": "string",
              "description": "보조 설명. 예: - 사례를 바탕으로 정리"
            }
          }
        }
      },
      "takeaways": {
        "type": "array",
        "description": "07 / TAKEAWAYS에 들어갈 핵심 정리 박스 3개",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "body"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "박스 제목. 반드시 핵심 정리, 요약, 한마디 중 하나"
            },
            "body": {
              "type": "string",
              "description": "박스 본문"
            }
          }
        }
      },
      "further_reading": {
        "type": "array",
        "description": "08 / FURTHER READING 관련 도서 목록",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "author",
            "reason"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "책 또는 자료 제목"
            },
            "author": {
              "type": "string",
              "description": "저자 또는 기관"
            },
            "reason": {
              "type": "string",
              "description": "추천 이유"
            }
          }
        }
      },
      "sources": {
        "type": "array",
        "description": "리포트 작성에 사용한 출처 목록",
        "minItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisher",
            "title",
            "url",
            "used_for"
          ],
          "properties": {
            "publisher": {
              "type": "string",
              "description": "출처 기관 또는 매체"
            },
            "title": {
              "type": "string",
              "description": "출처 제목"
            },
            "url": {
              "type": "string",
              "description": "출처 URL"
            },
            "used_for": {
              "type": "string",
              "description": "이 출처를 사용한 목적"
            }
          }
        }
      }
    }
  }
}

